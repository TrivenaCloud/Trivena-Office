{
  "name": "@trivoffice/shell",
  "productName": "TrivOffice",
  "version": "0.6.1",
  "license": "Apache-2.0",
  "homepage": "https://github.com/TrivenaCloud/Trivena-Office",
  "private": true,
  "description": "Unified TrivOffice shell: one app hosting the docs and sheets modules behind a home/launcher window",
  "main": "out/main/index.js",
  "desktopName": "trivoffice.desktop",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "electron-vite build && electron .",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "dist:mac:publish": "electron-vite build && electron-builder --mac --publish always",
    "dist:win:publish": "electron-vite build && electron-builder --win --publish always",
    "dist:linux:publish": "electron-vite build && electron-builder --linux --publish always"
  },
  "devDependencies": {
    "@trivoffice/agent-core": "*",
    "@trivoffice/ai-provider": "*",
    "@trivoffice/ai-search": "*",
    "@trivoffice/docs": "*",
    "@trivoffice/docx-engine": "*",
    "@trivoffice/electron-utils": "*",
    "@trivoffice/i18n": "*",
    "@trivoffice/pptx-engine": "*",
    "@trivoffice/pptx-render": "*",
    "@trivoffice/sheets": "*",
    "@trivoffice/slides": "*",
    "@trivoffice/ui": "*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  },
  "author": "TrivOffice"
}
